# Copy to .env before running. Sensible defaults work out of the box.

SECRET_KEY=change-this-to-a-random-secret-key
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

DB_ENGINE=sqlite
DB_NAME=beauto
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

TIME_ZONE=Asia/Kolkata

# Email — console backend prints links to your terminal (fine for local dev).
# For Gmail SMTP, use an "App Password", not your real password.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Beauto <no-reply@beauto.local>

SITE_DOMAIN=http://127.0.0.1:8000
DEFAULT_SERVICE_RADIUS_KM=15
